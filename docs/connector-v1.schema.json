{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoTTY Hub connector v1 envelope",
  "type": "object",
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "enum": [
        "hello",
        "hello_ack",
        "status",
        "open",
        "data",
        "asr_data",
        "view",
        "close",
        "rotate",
        "rotated",
        "revoked",
        "superseded"
      ]
    },
    "stream": {
      "type": "string"
    },
    "data": {}
  },
  "additionalProperties": false
}
